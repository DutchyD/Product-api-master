{% extends 'layout.html.twig' %}
{% import 'components/badge.html.twig' as badges %}
{% import 'components/icon.html.twig' as icons %}
{% import 'components/price.html.twig' as prices %}

{% set availabilityTones = { InStock: 'success', LowStock: 'warning', OutOfStock: 'danger' } %}
{% set imageCount = product.imageUrls|length %}
{% set filledStars = product.rating|round %}

{% block title %}{{ product.title }}{% endblock %}

{% block content %}
    <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm" role="list">
            <li><a href="/products" class="inline-flex min-h-6 items-center font-semibold text-link underline-offset-2 hover:underline">Products</a></li>
            <li class="flex min-w-0 items-center gap-2">
                <span class="text-muted">{{ icons.icon('chevron-right', 'size-4') }}</span>
                <span aria-current="page" class="text-muted">{{ product.title }}</span>
            </li>
        </ol>
    </nav>

    <div class="grid gap-6 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-7">
            {% embed 'components/panel.html.twig' with { padding: 'normal' } %}
                {% block content %}
                    {% if imageCount > 0 %}
                        <img src="{{ product.imageUrls|first }}" alt="{{ product.title }}, image 1 of {{ imageCount }}" width="640" height="640" referrerpolicy="no-referrer" class="aspect-square w-full rounded-2xl bg-white object-contain" data-gallery-image>
                    {% else %}
                        <img src="{{ product.thumbnailUrl }}" alt="{{ product.title }}" width="640" height="640" referrerpolicy="no-referrer" class="aspect-square w-full rounded-2xl bg-white object-contain" data-gallery-image>
                    {% endif %}
                {% endblock %}
            {% endembed %}
            {% if imageCount > 1 %}
                <ul class="mt-4 grid grid-cols-3 gap-3 sm:grid-cols-4" role="list">
                    {% for imageUrl in product.imageUrls|slice(1) %}
                        <li class="glass rounded-2xl p-2 shadow-glass ring-1 ring-white/70">
                            <img src="{{ imageUrl }}" alt="{{ product.title }}, image {{ loop.index + 1 }} of {{ imageCount }}" width="160" height="160" loading="lazy" referrerpolicy="no-referrer" class="aspect-square w-full rounded-xl bg-white object-contain" data-gallery-image>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        <div class="flex flex-col gap-6 lg:col-span-5">
            <div>
                <div class="flex flex-wrap gap-2">
                    {{ badges.badge(product.category) }}
                    <span data-availability>{{ badges.badge(product.availabilityStatus.value, availabilityTones[product.availabilityStatus.name]) }}</span>
                </div>
                <h1 class="mt-3 text-3xl leading-tight font-bold tracking-tight text-ink sm:text-4xl">{{ product.title }}</h1>
                <p class="mt-2 text-muted">{{ product.brand is null ? 'No brand' : 'by ' ~ product.brand }}</p>
                <div class="mt-3 flex items-center gap-2">
                    <span class="flex" aria-hidden="true">
                        {% for star in 1..5 %}
                            {{ icons.star(star <= filledStars ? 'size-5 text-primary-from' : 'size-5 text-control/40') }}
                        {% endfor %}
                    </span>
                    <span class="text-sm font-semibold text-muted" data-rating>Rated {{ product.rating|number_format(2, ',', '.') }} out of 5</span>
                </div>
            </div>

            <section aria-labelledby="price-title" class="rounded-3xl bg-linear-to-br from-highlight-from to-highlight-to p-6 text-white shadow-glass">
                <h2 id="price-title" class="text-xs font-semibold tracking-[0.2em] uppercase">Price</h2>
                <div class="mt-3">{{ prices.price(product, 'large', 'light') }}</div>
                <dl class="mt-5 grid grid-cols-2 gap-4 border-t border-white/30 pt-4 text-sm">
                    <div>
                        <dt class="font-medium">In stock</dt>
                        <dd class="mt-0.5 text-lg font-bold">{{ product.stock }}</dd>
                    </div>
                    <div>
                        <dt class="font-medium">Minimum order</dt>
                        <dd class="mt-0.5 text-lg font-bold">{{ product.minimumOrderQuantity }}</dd>
                    </div>
                </dl>
            </section>

            {% embed 'components/panel.html.twig' with { element: 'section', labelledBy: 'description-title' } %}
                {% block content %}
                    {%- import 'components/badge.html.twig' as badges -%}
                    <h2 id="description-title" class="text-lg font-bold text-ink">Description</h2>
                    <p class="mt-2 text-muted">{{ product.description }}</p>
                    {% if product.tags is not empty %}
                        <h3 class="mt-5 text-sm font-bold text-ink">Tags</h3>
                        <ul class="mt-2 flex flex-wrap gap-2" role="list" data-tags>
                            {% for tag in product.tags %}
                                <li>{{ badges.badge(tag) }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    {% embed 'components/panel.html.twig' with { element: 'section', labelledBy: 'specifications-title', classes: 'mt-6' } %}
        {% block content %}
            <h2 id="specifications-title" class="text-lg font-bold text-ink">Specifications</h2>
            <div class="mt-4 flex flex-col gap-6 md:flex-row md:items-start">
                <dl class="grid flex-1 gap-x-6 gap-y-4 sm:grid-cols-2" data-specifications>
                    {% for term, description in {
                        'SKU': product.sku,
                        'Barcode': product.barcode,
                        'Weight': product.weight|number_format(2, ',', '.'),
                        'Dimensions (width × height × depth)': product.dimensions.width|number_format(2, ',', '.') ~ ' × ' ~ product.dimensions.height|number_format(2, ',', '.') ~ ' × ' ~ product.dimensions.depth|number_format(2, ',', '.'),
                        'Warranty': product.warrantyInformation,
                        'Shipping': product.shippingInformation,
                        'Return policy': product.returnPolicy,
                        'Added at dummyjson.com': product.sourceCreatedAt|date('Y-m-d H:i', 'UTC') ~ ' UTC',
                        'Updated at dummyjson.com': product.sourceUpdatedAt|date('Y-m-d H:i', 'UTC') ~ ' UTC',
                    } %}
                        <div>
                            <dt class="text-xs font-semibold tracking-wider text-muted uppercase">{{ term }}</dt>
                            <dd class="mt-1 text-ink">{{ description }}</dd>
                        </div>
                    {% endfor %}
                </dl>
                <figure class="flex shrink-0 flex-col items-center gap-2">
                    <img src="{{ product.qrCodeUrl }}" alt="QR code for {{ product.title }}" width="128" height="128" loading="lazy" referrerpolicy="no-referrer" class="size-32 rounded-2xl bg-white p-2 ring-1 ring-control">
                    <figcaption class="text-xs font-semibold text-muted">QR code</figcaption>
                </figure>
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
