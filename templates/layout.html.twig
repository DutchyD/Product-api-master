<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Products{% endblock %} · MaxServ B.V. assignment</title>
    <style>
        body { font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 64rem; padding: 0 1rem; color: #1f2328; }
        table { border-collapse: collapse; width: 100%; }
        th, td { border-bottom: 1px solid #d0d7de; padding: 0.5rem; text-align: left; vertical-align: middle; }
        td.price, th.price { text-align: right; white-space: nowrap; }
        .original-price { color: #6e7781; margin-right: 0.5rem; }
        .discount-price { font-weight: 600; }
        .thumbnail { width: 64px; height: 64px; object-fit: contain; }
        .gallery img { width: 160px; height: 160px; object-fit: contain; margin: 0 0.5rem 0.5rem 0; }
        .message { padding: 0.75rem 1rem; border-radius: 0.375rem; margin-bottom: 1rem; }
        .message.success { background: #dafbe1; }
        .message.error { background: #ffebe9; }
        .pager { display: flex; gap: 1rem; align-items: center; margin: 1rem 0; flex-wrap: wrap; }
        form.import, form.filters { display: flex; gap: 1rem; align-items: end; flex-wrap: wrap; margin-bottom: 1.5rem; }
        form.import label, form.filters label { display: flex; flex-direction: column; gap: 0.25rem; }
        th a { color: inherit; }
        .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
        dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1rem; }
        dt { font-weight: 600; }
        dd { margin: 0; }
    </style>
</head>
<body>
    {% block body %}{% endblock %}
</body>
</html>
