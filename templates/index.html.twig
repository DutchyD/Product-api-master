{% extends 'layout.html.twig' %}

{% block title %}{% endblock %}

{% block content %}
    {%- import 'components/button.html.twig' as buttons -%}
    <section aria-labelledby="hero-title" class="relative overflow-hidden rounded-[2rem] [&_a:focus-visible]:outline-white bg-linear-to-br from-highlight-from to-highlight-to px-6 py-12 text-white shadow-glass sm:px-10 sm:py-16 lg:px-14 lg:py-20">
        <div class="pointer-events-none absolute -top-16 -right-16 size-64 rounded-full bg-orb-pink/20 blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -bottom-20 left-1/3 size-72 rounded-full bg-orb-sky/20 blur-3xl" aria-hidden="true"></div>
        <div class="relative max-w-2xl">
            <p class="text-xs font-semibold tracking-[0.2em] uppercase">Product catalogue</p>
            <h1 id="hero-title" class="mt-3 text-3xl leading-tight font-bold sm:text-4xl lg:text-5xl">Browse and import products from dummyjson.com</h1>
            <p class="mt-4 max-w-xl text-base sm:text-lg">Bring the dummyjson.com products into your own database, then filter, sort and explore every product in detail.</p>
            <div class="mt-8 flex flex-wrap gap-3">
                {{ buttons.link('Browse products', '/products', 'primary', 'arrow-right') }}
                {{ buttons.link('Import products', '/products/import', 'secondary', 'arrow-down-tray') }}
            </div>
        </div>
    </section>

    <ul class="mt-8 grid gap-4 sm:grid-cols-3 sm:gap-6" role="list">
        {% for feature in [
            { icon: 'arrow-down-tray', title: 'Import', text: 'Fetch up to 200 products in one go. Products you already have are updated, never duplicated.' },
            { icon: 'funnel', title: 'Filter and sort', text: 'Narrow the list by category and brand, and sort it by title, price, brand or category.' },
            { icon: 'archive-box', title: 'Product details', text: 'See every image, the price with its discount, stock, specifications and tags.' },
        ] %}
            <li>
                {% embed 'components/panel.html.twig' with { classes: 'h-full' } %}
                    {% block content %}
                        {%- import 'components/icon.html.twig' as icons -%}
                        <span class="grid size-11 place-items-center rounded-2xl bg-badge-violet-bg text-badge-violet-text">{{ icons.icon(feature.icon, 'size-6') }}</span>
                        <h2 class="mt-4 text-lg font-bold text-ink">{{ feature.title }}</h2>
                        <p class="mt-1 text-muted">{{ feature.text }}</p>
                    {% endblock %}
                {% endembed %}
            </li>
        {% endfor %}
    </ul>
{% endblock %}
