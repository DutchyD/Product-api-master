<?xml version="1.0" encoding="UTF-8"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        name = "Product API"
        xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
    <description>The PSR-12 coding standard for the project's PHP code.</description>

    <file>bin/migrate</file>
    <file>public/index.php</file>
    <file>packages/core/src</file>
    <file>packages/core/tests</file>
    <file>packages/app/src</file>
    <file>packages/app/tests</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- Entry scripts must define APPLICATION_ROOT before they run the bootstrap. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>*/public/index\.php$</exclude-pattern>
        <exclude-pattern>*/bin/migrate$</exclude-pattern>
    </rule>
</ruleset>