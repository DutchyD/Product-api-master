# Ignore everything by default
*

# Project files
!/.gitignore
!/README.md
!/IMPLEMENTATION.md
!/public
!/public/index.php
!/public/fonts
!/public/fonts/*
!/public/assets
!/public/assets/.gitkeep

# Composer
!/composer.json
!/composer.lock

# Command line scripts
!/bin
!/bin/*

# Stylesheet source
!/assets
!/assets/**/*

# Database migrations
!/database
!/database/**/*

# Tests
!/phpunit.xml.dist
/.phpunit.cache

# Docker
!/Dockerfile
!/docker-compose.yml
!/.dockerignore

# Configuration
!/config
!/config/*.yaml

# Templates
!/templates
!/templates/**/*

# Packages
!/packages
!/packages/core
!/packages/core/**/*
!/packages/app
!/packages/app/**/*
