# Ignore everything by default
*

# Project files
!/.gitignore
!/README.md
!/IMPLEMENTATION.md
!/public
!/public/index.php

# Composer
!/composer.json
!/composer.lock

# Command line scripts
!/bin
!/bin/*

# Database migrations
!/database
!/database/**/*

# Tests
!/phpunit.xml.dist
/.phpunit.cache

# Lint
!/phpcs.xml.dist

# Docker
!/Dockerfile
!/docker-compose.yml
!/.dockerignore

# Configuration
!/config
!/config/*.yaml

# Templates
!/templates
!/templates/**/*

# Packages
!/packages
!/packages/core
!/packages/core/**/*
!/packages/app
!/packages/app/**/*
